        <profile name="Damaged: 1-6 wounds remaining" id="f152-0b92-6e01-e1a4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-6 wounds remaining, each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Invulnerable Save" id="71e7-03c6-995d-67ff" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scourge of the Warp" id="03d3-0f17-92cb-18c2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the battle round, select one Scourge of the Warp abilities. Until the start of your next Command phase, this model has those abilities.</characteristic>
          </characteristics>
        </profile>
        <profile name="Raven Guard Bodyguard" id="f6d1-05fb-1396-0810" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3&quot; of one or more friendly Adeptus Astartes Infantry units, enemy models have -1 to hit this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Primarch of the 19th Legion" id="74c2-c777-c392-76cf" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this model is in your army, it must be your Warlord.</characteristic>
          </characteristics>
        </profile>
        <profile name="Warp Lurker" id="3f57-9f6a-3f75-6f10" hidden="false" typeId="6c02-76c1-3d23-cb4c" typeName="Scourge of the Warp">
          <characteristics>
            <characteristic name="Effect" typeId="e418-4b7e-f9d9-edf7">While a friendly Adeptus Astartes Infantry unit is within 6&quot; of this model, that unit can only be targeted by a ranged attack if the attacking model is within 18&quot;.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shadow Incursion" id="0334-58b0-55e9-c127" hidden="false" typeId="6c02-76c1-3d23-cb4c" typeName="Scourge of the Warp">
          <characteristics>
            <characteristic name="Effect" typeId="e418-4b7e-f9d9-edf7">Each time a Adeptus Astartes Infantry unit from your army is set up on the battlefield using the Deep Strike ability, it may be set up within 6&quot; of this model, and at least 6&quot; away from enemy units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Predatory Hawk" id="98ce-eb8e-95c3-91d4" hidden="false" typeId="6c02-76c1-3d23-cb4c" typeName="Scourge of the Warp">
          <characteristics>
            <characteristic name="Effect" typeId="e418-4b7e-f9d9-edf7">Whenever this model makes an attack that targets your Oath of Moment Target, add 1 to the wound roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
