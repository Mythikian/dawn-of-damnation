        <selectionEntryGroup name="Legendary Relics" id="85e3-5c60-8c2d-18f3" hidden="false" sortIndex="3">
          <selectionEntries>
            <selectionEntry name="Athenaean Scrolls" id="d7d6-05b0-30f9-98d2" hidden="false" import="true" type="upgrade">
