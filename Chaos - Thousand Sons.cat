          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemon Prince of Tzeentch with wings" id="a6be-878c-42ec-a96e" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
