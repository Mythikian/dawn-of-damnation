          </modifiers>
          <profiles>
            <profile name="Warp Strider" id="0b69-2b0c-0d7a-dba2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 1&quot; to the Move characteristic of models in this model&apos;s unit, and each time a model in this model&apos;s unit makes a Normal, Advance, Fall Back or Charge move, it can move horizontally through models and terrain features. If this model is wholly within your opponent&apos;s deployment zone at the end of the battle, roll one D6: on a 4+, this model gains 1 Arcana point.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Forewarned by Fate" id="0917-3a8b-4143-c714" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="80ed-a129-fa9f-b076" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="1"/>
            <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="1"/>
            <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0"/>
