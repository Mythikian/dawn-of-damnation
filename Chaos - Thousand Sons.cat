                  <profiles>
                    <profile name="Shadow Puppeteer (Psychic)" id="0c6c-cce8-41d2-6d4c" hidden="false" typeId="6be6-a982-36ad-841a" typeName="Rituals">
                      <characteristics>
                        <characteristic name="Warp Charge" typeId="ace0-c8c2-e1fe-18b0">8</characteristic>
                        <characteristic name="Effect" typeId="4e3c-58dd-9e6e-e1f4">Select one enemy unit within 24&quot; of and visible to the manifesting model. Until the start of your next Shooting phase, each time a model in that unit makes an attack, subtract 1 from the Hit roll. If the Psychic test result for this Ritual was 12+, subtract 1 from the Wound roll as well.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
