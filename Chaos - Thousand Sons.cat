        <profile name="Warp-Warded Citadel (Aura, Psychic)" id="c2c1-a0d3-8113-f233" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly ^^**THOUSAND SONS**^^ unit is within 6” of this model, that unit has a 5+ Invulnerable Save. If it already has an invulnerable save, instead improve it by 1 (to a maximum of 4+).</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged: 1-8 Wounds Remaining" id="1c27-bc01-75a4-422b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-8 wounds remaining, subtract 4 from its Objective Control characteristic and each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Reality Fractured" id="1a83-63ca-0db4-5231" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Whenever a unit is successfully hit by this model’s Reality Fracture weapon, that unit must then take a Battle-shock test with a -1 penalty.</characteristic>
          </characteristics>
        </profile>
      </profiles>
