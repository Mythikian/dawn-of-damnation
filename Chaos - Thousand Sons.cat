                </modifier>
              </modifiers>
              <profiles>
                <profile name="Perfidious Tome" id="304d-2b28-ed3f-94f7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time the bearer Channels the Warp, before rolling the additional D6, the bearer can use this Crusade Relic. If it does, take a Battle-shock test for the bearer: if that test is passed, the bearer gains 1 Lore point and that additional D6 is automatically an unmodified 6; otherwise the Ritual being attempted fails.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
