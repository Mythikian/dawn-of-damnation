      <profiles>
        <profile name="Vulkan&apos;s Trusted" id="22f3-b5dd-3103-edd5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a model in this unit targets an enemy unit with an attack, re-roll a Wound roll of 1. If that enemy unit is within range of an objective marker, you can re-roll the Wound roll instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="Blackstone Task Force" id="c675-5c75-ec99-5a0e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Durring your command phase you may activate this ability, if you do this unit splits into separate units, each containing one model. These new units each have a Starting Strength of 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Attached Unit" id="cef2-3a5e-fd90-c7bb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If a character unit from your army with the leader ability can be attached to a Terminator Squad, it can be attached to this unit instead.</characteristic>
          </characteristics>
        </profile>
      </profiles>
