          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, select two Ruler of Nocturne abilities. Until the start of your next Command phase, this model has those abilities.</characteristic>
          </characteristics>
        </profile>
        <profile name="Salamanders Bodyguard" id="a892-b487-698c-edfd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3&quot; of one or more friendly Adeptus Astartes Infantry units, this model has the Lone Operative ability</characteristic>
          </characteristics>
        </profile>
        <profile name="Perpetual" id="48ed-6573-ce73-5142" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, roll one D6 at the end of the phase: on a 2+, set this model back up on the battlefield as close as possible to where it was destroyed and not within Engagement Range of any enemy models, with 6 wounds remaining. Every time this ability is triggered this ability has a permenant -1 to the roll made for this check, and Vulkan comes back with half of the wounds he last revived with rounding down.</characteristic>
          </characteristics>
        </profile>
        <profile name="Primarch of Flame" id="4b2c-b073-dcd6-665d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this model is in your army, it must be your Warlord.</characteristic>
          </characteristics>
        </profile>
        <profile name="Into the Fire (Aura)" id="6a8d-15bd-5086-87b1" hidden="false" typeId="a70c-e780-23ac-b35d" typeName="Ruler of Nocturne">
          <characteristics>
            <characteristic name="Ability" typeId="fbf4-9abf-05c1-71cb">Ranged weapons equipped by friendly ADEPTUS ASTARTES units within 6&quot; gain the [ASSAULT] keyword, if they already have the [ASSAULT] keyword on all their ranged weapons then they may reroll Advance rolls instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="Where He is Needed" id="547a-7424-5d15-a321" hidden="false" typeId="a70c-e780-23ac-b35d" typeName="Ruler of Nocturne">
          <characteristics>
            <characteristic name="Ability" typeId="fbf4-9abf-05c1-71cb">At the end of your opponent&apos;s turn, if this model is not within 3&quot; of one or more enemy units, you can remove it from the battlefield and then, in the Reinforcements step of your next Movement phase, set it up anywhere on the battlefield that is more than 9&quot; horizontally away from all enemy models. If the battle ends and this model is not on the battlefield, it is destroyed.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scorching Heat (Aura)" id="bf9d-3c87-836a-1675" hidden="false" typeId="a70c-e780-23ac-b35d" typeName="Ruler of Nocturne">
          <characteristics>
            <characteristic name="Ability" typeId="fbf4-9abf-05c1-71cb">While a friendly ADEPTUS ASTARTES unit is within 6&quot; of this model, improve the Armour Penetration characteristic of ranged weapons equipped by that unit by 1 when attacking an enemy unit within 12” of it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
