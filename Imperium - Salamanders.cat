      <profiles>
        <profile name="Occulix Targeting Auspex" id="3a22-acba-915e-01fd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can target this unit with the Fire Overwatch Stratagem even if you have used it with another unit this turn. Each time you target this unit with the Fire Overwatch Stratagem, hits are scored on unmodified Hit rolls of 5+ while resolving that Stratagem.</characteristic>
          </characteristics>
        </profile>
        <profile name="Saturnine Armor" id="8412-df42-6c5e-9702" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit embarks in a Transport, each model counts as being a Centurion model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Implacable Advance" id="36fd-9817-24ba-4eb0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit may Shoot and Charge in the same turn it Fell Back, but it must roll only one die when charging.</characteristic>
          </characteristics>
        </profile>
      </profiles>
