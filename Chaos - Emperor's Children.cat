        <profile name="The Wolf of the Exhaust (Aura)" id="535f-e5c0-8712-91a4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly EMPEROR&apos;S CHILDREN MOUNTED or VEHICLE unit is within 6&quot; of this model, you can re-roll Charge rolls made for that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Warp-Exhuast Plume" id="f9f7-000c-12f0-c7c6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Fight phase, roll one D6 for every enemy unit within Engagement Range of this model. On a 2-5, that unit suffers D3 mortal wounds. On a 6, it suffers D3+3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Twisted Biker" id="b24c-c5fc-5eb1-2722" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3&quot; of one or more friendly other SLAANESH MOUNTED units, this model has the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Invulnerable Save" id="fb87-0ab0-83da-b722" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
