            <cost name="Military Power" typeId="1cbe-d9c9-86a8-2d41" value="0"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="5c22-0807-79af-03da" field="selections" includeChildForces="false" includeChildSelections="false" scope="parent" shared="true" type="notInstanceOf" value="1"/>
                    <condition childId="d6e0-f0b0-5df4-71de" field="selections" includeChildForces="false" includeChildSelections="false" scope="parent" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier field="b03b-c239-15a5-da55" type="set" value="2">
              <conditions>
                <condition childId="5929-ad51-d006-e008" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Lethal Reverb" id="4e8a-5427-cf94-3421" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Shooting phase, after this unit has shot, select one enemy unit by one or more of those attacks. Until the start of your next turn, that enemy unit is suppressed. While a unit is suppressed, each time a model in that unit makes an attack, subtract 1 from the Hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Unbound Hubris" id="0be1-cbe7-2b4e-2598" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3a44-494d-f70a-3308" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="1"/>
            <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="1"/>
            <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0"/>
            <cost name="Diplomatic Power" typeId="4d7c-04b6-8a79-837f" value="0"/>
            <cost name="Military Power" typeId="1cbe-d9c9-86a8-2d41" value="0"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="9cfd-1c32-585f-7d5c" field="selections" includeChildForces="false" includeChildSelections="false" scope="parent" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
            <modifier field="b03b-c239-15a5-da55" type="set" value="2">
              <conditions>
                <condition childId="5929-ad51-d006-e008" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Unbound Hubris" id="03e2-062d-6bd2-9e8a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time this model&apos;s unit is selected to fight, you and your opponent must secretly choose a number from 1 to 3 on a D6 (we suggest turning a D6 to show the number, but concealing it behind your hand), then reveal your choices simultaneously. If the chosen numbers differ, then until that fight is resolved, add the number you chose to the Attacks characteristic of this model&apos;s melee weapons.

At the end of the battle, if one or more models from your Crusade army with this Battle Trait destroyed on or more **^^Adeptus Astartes^^**, **^^Deathwatch^^** or **^^Grey Knights^^** units with a melee attack during the battle, you gain 1 Distillate of Hatred.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Covetous Paragon" id="d05a-2b1e-7382-c96b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c2ad-c0ac-1b26-d719" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
