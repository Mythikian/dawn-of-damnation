        <profile name="Invulnerable Save" id="cdfd-857f-d981-a3b2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Perfectionists" id="197e-a2ea-b468-48d9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, weapons equipped by models in that unit have the **^^[LETHAL HITS]^^** ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Euphoric Strikes" id="828a-cdf4-e64a-cf75" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle, at the start of the Fight phase, this model can use this ability. If it does so, until the end of the phase, add 3 to the Attacks characteristic of melee weapons equipped by this model and improve the Armour Penetration characteristic of those weapons by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of the Host" id="3cf5-ff3c-e78d-51c8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this model is attached to an **^^Emperor&apos;s Children Battleline^^** unit during the Declare Battle Formations step, this model has the Infiltrators and Scouts 6&quot; ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="8799-26c2-ca52-3969" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units: **^^Infractors; Tormentors^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
