        <profile name="Unrestrained Sensation (Aura)" id="9693-2d23-2a3c-34e4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly Emperor&apos;s Children unit is within 6&quot; of this model, each time that unit makes a advances, until the end of the phase: Its weapons gain [SUSTAINED HITS 1], and Attacks made by that unit ignore negative hit modifiers.</characteristic>
          </characteristics>
        </profile>
        <profile name="Devoted to Destruction" id="c906-e2c3-d6d6-a52c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this model is equipped with 2 melee weapons in addition to its close combat weapon, add 2 to the Attacks characteristics of those 2 weapons.</characteristic>
          </characteristics>
        </profile>
