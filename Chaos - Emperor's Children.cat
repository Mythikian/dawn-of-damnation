    <categoryEntry name="Faction: Legions of Excess" id="4c25-d2f3-36bb-8067" hidden="false">
      <constraints>
        <constraint id="9f42-45d1-6365-8687" field="51b2-306e-1021-d207" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="0"/>
      </constraints>
      <modifiers>
        <modifier field="9f42-45d1-6365-8687" type="set" value="500">
          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="greaterThan" value="0"/>
          </conditions>
        </modifier>
        <modifier field="9f42-45d1-6365-8687" type="set" value="1000">
          <conditions>
            <condition childId="baf8-997f-e323-a090" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="greaterThan" value="0"/>
          </conditions>
        </modifier>
        <modifier field="9f42-45d1-6365-8687" type="set" value="1500">
          <conditions>
            <condition childId="4204-82d0-908c-a62a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="greaterThan" value="0"/>
          </conditions>
        </modifier>
        <modifier field="9f42-45d1-6365-8687" type="set" value="-1">
          <conditions>
            <condition childId="cac3-71d1-ea4b-795d" field="selections" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Legions of Excess" id="2bc8-7260-97f3-265e" hidden="false">
          <description>You can include **^^Legions of Excess**^^ units in your army, even though they do not have the ^^**Emperor&apos;s Children**^^ Faction keyword. The combined points cost of such units you can include in your army is:
- **Incursion**: Up to 500pts

- **Strike Force**: Up to 1000pts
- **Onslaught**: Up to 1500pts


No **^^Legions of Excess**^^ models from your army can be your **^^Warlord**^^.</description>
        </rule>
      </rules>
    </categoryEntry>
