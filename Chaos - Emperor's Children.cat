        </selectionEntryGroup>
        <selectionEntryGroup name="Legendary Relics" id="2712-fa1f-bc2c-e3b1" hidden="false" sortIndex="3">
          <selectionEntries>
            <selectionEntry name="Blissgiver" id="c378-a5fa-1528-f558" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="24c8-1a06-e0c7-b370" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
