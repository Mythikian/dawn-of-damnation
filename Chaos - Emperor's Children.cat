            <profile name="Spearhead Striker" id="c223-7cd0-78f8-f484" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time the bearer disembarks from a **^^Transport**^^, until the end of the turn, you can re-roll Charge rolls made for the bearer&apos;s unit and enemy units cannot use the Fire Overwatch Stratagem to shoot at the bearer&apos;s unit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
