                    <modifier affects="self.entries.recursive.profiles.Melee Weapons" field="893f-9000-ccf7-648e" join=", " scope="model" type="append" value="Devastating Wounds, Precision"/>
                    <modifier affects="self.entries.recursive.e993-e086-6de1-12af.profiles.Melee Weapons" arg="+0" field="2337-daa1-6682-b110" join="" scope="model" type="append" value="+0"/>
