          </characteristics>
        </profile>
        <profile name="Inviolable Transport" id="7403-4ad3-f2b0-cf99" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle round, when an attack is allocated to this model, you can change the Damage characteristic of that attack to 0.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mastodon" id="249a-bc7e-1789-17e9" hidden="false" typeId="74f8-5443-9d6d-1f1e" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="30f2-be70-861d-1b84">This model has a transport capacity of 45 &lt;FACTION&gt; INFANTRY models. Each JUMP PACK, WULFEN, GRAVIS, POSSESSED or TERMINATOR model takes up the space of 2 models and each CENTURION or OBLITERATOR model takes up the space of 3 models. This model can also transport up to 2 DREADNOUGHT or HELBRUTE models (these models take up the space of a number of models equal to their Wounds characteristic e.g. A DREADNOUGHT with a Wounds characteristic of 8 would take up the space of 8  models).</characteristic>
          </characteristics>
        </profile>
      </profiles>
