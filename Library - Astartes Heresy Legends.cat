        <profile name="Kharybdis Assault Claw" id="a510-9d3d-adf2-4459" hidden="false" typeId="74f8-5443-9d6d-1f1e" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="30f2-be70-861d-1b84">This model has a transport capacity of 22 HERETIC ASTARTES INFANTRY models. Each JUMP PACK, POSSESSED and TERMINATOR model takes up the space of 2 models. Each OBLITERATOR model takes up the space of 3 models. This model can instead transport 1 HELBRUTE or DREADNOUGHT model.</characteristic>
          </characteristics>
        </profile>
