  <sharedProfiles>
    <profile name="Damaged: 1-5 wounds remaining" id="97fd-09c5-60a8-63c4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-5 wounds remaining, subtract 3 from this model&apos;s Objective Control characteristic and each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Damaged: 1-9 wounds remaining" id="12ce-2a62-9fea-74bd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-6 wounds remaining, subtract 4 from this model&apos;s Objective Control characteristic and each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Damaged: 1-10 wounds remaining" id="7400-7387-dae-781f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-10 wounds remaining, subtract 5 from this model’s Objective Control characteristic and each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Huntmaster (Aura)" id="73ac-6b3a-8480-d08a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly ^^**War Dog^^** model is within 6&quot; of this model, ranged weapons equipped by that **^^War Dog^^** model have the [ASSAULT] ability.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dread Tyrants (Aura)" id="1114-b788-97de-7a2d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly ^^**Damned^^** unit is within 9&quot; of this unit, each time a model in that unit makes an attack, re‑roll a Hit roll of 1 and re‑roll a Wound roll of 1.</characteristic>
      </characteristics>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="7fe8-de91-8976-e705" field="selections" includeChildSelections="true" scope="force" shared="true" type="lessThan" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
    </profile>
    <profile name="Dark Sacrifice" id="0b98-37c4-6be9-f608" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a ^^**Chaos Knights^^** unit with this ability is selected to shoot or fight, it can make a Dark Sacrifice. If it does, select one friendly ^^**Damned^^** unit within 6&quot;. That ^^**Damned^^** unit must take a Leadership test: if passed, destroy D3 models in that ^^**Damned^^** unit; if failed, destroy D3+3 models in that ^^**Damned^^** unit. In either case, then select one of the following abilities for your Chaos Knights unit’s weapons to have until the end of the phase: [LETHAL HITS]; [SUSTAINED HITS 1].</characteristic>
      </characteristics>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
