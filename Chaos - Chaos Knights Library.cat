        <profile name="Invulnerable Save" id="f81f-fb98-17a1-08e0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a 5+ invulnerable save against ranged attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hooked Prey" id="c9c6-cc43-f2bd-fe8a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time one or more attacks made with this model&apos;s Soulflayer harpoons score a hit against an enemy unit, that unit must take a Battle-shock test. If failed, that unit cannot Fall Back until the start of your next turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Slaughter Rush" id="fa06-5014-2f14-29ed" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In a turn in which this model made a Charge move, add 2 to the Attacks characteristic of Carnage chain-glaive and Warp-cleaver weapons equipped by this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged: 1-6 Wounds Remaining" id="81d3-4960-0897-5d3f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-6 wounds remaining, subtract 4 from this model&apos;s Objective Control characteristic and each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Profane Aura" id="8acc-a678-74fc-f2c2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While an enemy unit is within 6&quot; of this model, subtract 1 from Battle-shock tests taken for that unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
