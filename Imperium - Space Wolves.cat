      <profiles>
        <profile name="Wulfen Dreadnought" id="77af-6fe4-d935-e125" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">9&quot;</characteristic>
