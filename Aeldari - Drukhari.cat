            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">5</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader of the Kabal" id="b27e-eb57-74ba-6133" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this model is in your army, it must be your WARLORD.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supreme Overlord of Commorragh" id="9584-cb37-2f4c-a6cc" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is on the battlefield, you gain 1 additional Command Point at the start of your Command phase. Also, the first time your opponent uses a Stratagem each turn, on a 5+, that Stratagem costs them 1 additional CP.</characteristic>
          </characteristics>
        </profile>
        <profile name="Dark Muse (Aura)" id="6c47-4df0-c538-9dcb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly DRUKHARI unit is within 6&quot; of this model, improve that unit’s Leadership characteristic by 1 and each time that unit destroys an enemy unit, you gain 1 additional Pain token.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hatred Eternal (Pain)" id="a58d-a9cc-a705-cdc2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Shooting or the Fight phase, when you select this model to shoot or fight, you can spend 1 Pain token to Empower that unit. While that unit is Empowered, each time this model makes an attack, you can re-roll the Hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged: 1-5 Wounds Remaining" id="b3e5-cc0b-e8d2-5334" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-5 wounds remaining, each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
