          <profiles>
            <profile name="Necromechanic" id="b24d-f2a5-2be-8b59" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle round, when a saving throw made for a friendly **^^Legio Cybernetica^^** or **^^Adeptus Mechanicus Vehicle^^** model within 12&quot; of the bearer is failed, the bearer can use this Enhancement. If they do, change the Damage characteristic of that attack to 0.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Lord of Machines" id="5f0a-b46d-1ade-9d4e" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="74ab-2e57-2ef6-3ff3" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
