        <profile name="Augmetic Implants" id="3d74-3888-b3ba-d044" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a model with this ability suffers damage and so would lose a wound (including wounds lost due to mortal wounds), roll one D6: if the result is greater than or equal to 5 that wound is ignored and is not lost.If this model is effected by a Feel No Pain rule, it can only benefit from that or this rule.</characteristic>
          </characteristics>
        </profile>
