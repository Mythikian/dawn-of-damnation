          <profiles>
            <profile name="Voltagheist Shock" id="1dbd-0622-023e-7a10" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle round, in your opponent&apos;s Charge phase, just after an enemy unit selects this unit as the target of a charge, roll one D6: on a 3+, that enemy unit suffers D3 mortal wounds and must take a Battle-shock test.</characteristic>
              </characteristics>
            </profile>
          </profiles>
