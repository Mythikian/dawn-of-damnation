        <profile name="Mindlock" id="130a-d876-45f9-5e77" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a ^^**Tech-Priest^^** model is leading this model’s unit, improve the Ballistic Skill and Weapon Skill characteristics of this model’s weapons by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Bound Creation" id="ae61-c8d4-2a51-9793" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a ^^**Tech-Priest^^** model is leading this model’s unit, that ^^**Tech-Priest^^** model has the Feel No Pain 5+ ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Servitor Bodyguard" id="abe8-bb77-d6ba-db6c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Declare Battle Formations step, this model can join one other unit from your army that is being led by a ^^**Tech-Priest Infantry^^** model. If it does, until the end of the battle, this model counts as being part of that Bodyguard unit, and that Bodyguard unit’s Starting Strength is increased accordingly.</characteristic>
          </characteristics>
        </profile>
      </profiles>
