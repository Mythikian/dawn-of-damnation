              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The bearer, and models in any unit they are leading, have the Infiltrators and Scouts 6&quot; abilities.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
