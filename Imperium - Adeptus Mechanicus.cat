        </profile>
        <profile name="Archmagos Operatus" id="cb59-2ad8-546c-b4d0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your shooting phase, select one friendly ADEPTUS MECHANICUS unit within 3&quot; of this unit. Until the end of the phase, each time that unit makes an attack with a weapon, if a Critical Hit is rolled, that attack scores an additional hit on the target. A unit can only benefit from this rule once per turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
