              </infoLinks>
              <profiles>
                <profile name="Rapid Reanimation" id="e9f1-5c72-01f8-64e6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle round, you can re-roll the roll for one unit in your Crusade army&apos;s Reanimation Protocols ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Resurrection Flux" id="eed3-841c-e3c7-ff9b" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a689-e2cd-ac46-fdaf" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <infoLinks>
                <infoLink name="Reanimation Master System Ability - Contra-mortis Protocol" id="0699-d049-eea5-c566" hidden="false" targetId="ae48-c326-c13c-8442" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Resurrection Flux" id="dd02-9468-e232-e878" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a unit is Below Half-strength, add 1 to the result of that unit&apos;s Reanimation Protocols roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Anastasic Contingency" id="8f5a-9a95-6e71-70a4" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="68f1-804e-2ff9-9d7e" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <infoLinks>
                <infoLink name="Reanimation Master System Ability - Contra-mortis Protocol" id="a4c2-711a-d572-9ceb" hidden="false" targetId="ae48-c326-c13c-8442" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Anastasic Contingency" id="be82-970f-fcac-0e56" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle, after an enemy unit has caused a unit from your Crusade army to go below its Starting Strength, that unit can use its Reanimation Protocols ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Command System" id="3d7f-b0e9-5465-124a" hidden="false">
          <selectionEntries>
            <selectionEntry name="Harmonised Dynastic Hyperdermis" id="8235-90c5-30ef-0f78" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a24b-5ca8-a43c-9ca1" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <infoLinks>
                <infoLink name="Command Master System Ability - Directive Override" id="4cae-4c28-d739-996c" hidden="false" targetId="20c2-d3b0-78a7-e025" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Harmonised Dynastic Hyperdermis" id="9591-dea2-46c1-fce4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the battle, select one ^^**Character^^** unit and add 1 to the Toughness characteristic of models in that unit until the end of the battle.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Servile Preservation Protocols" id="b4fb-a7c8-b871-1f95" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="118d-65cd-e694-58b8" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <infoLinks>
                <infoLink name="Command Master System Ability - Directive Override" id="6c0a-92a3-1e65-b35c" hidden="false" targetId="20c2-d3b0-78a7-e025" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Servile Preservation Protocols" id="605b-ae70-86a3-9ba0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the battle, select one ^^**Character^^** unit. Each time a Bodyguard model in that unit is destroyed by a melee attack, if that model has not fought that phase, roll one D6: on a 3+, do not remove it from play. The destroyed model can fight after the attacking model&apos;s unit has finished making its attacks, and is then removed from play.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Remastered Deficiency" id="39a0-9e71-3fa7-6c88" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b94e-8f5a-d54f-8e56" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <infoLinks>
                <infoLink name="Command Master System Ability - Directive Override" id="b94c-5fbf-fb1b-9656" hidden="false" targetId="20c2-d3b0-78a7-e025" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Remastered Deficiency" id="bde4-b623-4e36-9529" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle round, you can target a **^^Necrons Character^^** unit from your army with the Command Re-roll Stratagem for 0CP, and can do so even if you have already targeted a different unit with that Stratagem this phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Translocation System" id="eb38-6116-d3d3-947a" hidden="false">
          <selectionEntries>
            <selectionEntry name="Astromantic Perception Portal" id="b27b-6b4e-a083-5802" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5800-9905-be28-54eb" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <infoLinks>
                <infoLink name="Translocation Master System Ability - Special Relocation" id="254f-2f46-d995-7de1" hidden="false" targetId="90f4-f767-7647-b9cc" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Astromantic Perception Portal" id="01c3-ee26-6917-3af8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per turn, select one **^^Necrons^^** unit that was set up on the battlefield using the Deep Strike ability this turn. Until the end of the turn, each time a model in that unit makes an attack, you can re-roll the Hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Dimensional Catacombs" id="282b-95d0-9b8f-aec4" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a8d2-29b8-c629-ac64" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <infoLinks>
                <infoLink name="Translocation Master System Ability - Special Relocation" id="a8e0-9178-9741-ae8a" hidden="false" targetId="90f4-f767-7647-b9cc" type="profile"/>
                <infoLink name="Scouts" id="ffcb-edba-a3d2-bbd1" hidden="false" targetId="ada6-bac1-ffe0-d6f7" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Dimensional Catacombs" id="fbdf-93b0-0f7e-a518" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Before the start of the battle, select up to three **^^Necrons Infantry^^** units from your Crusade army. Those units have the Scouts 6&quot; ability, and while using that ability, they can **^^Fly^^**.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Transtemporal Acceleration" id="3547-25bf-d3e1-e4ac" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2b56-4369-da6e-3dc1" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <infoLinks>
                <infoLink name="Translocation Master System Ability - Special Relocation" id="e892-44e4-5f35-7966" hidden="false" targetId="90f4-f767-7647-b9cc" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Transtemporal Acceleration" id="8989-e8a0-0b97-4447" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle, in your Command phase, select one **^^Necrons^^** unit from your Crusade army. Until the end of the turn, add 2 to Advance and Charge roll made for that unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntryGroup>
