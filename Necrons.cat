          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-4 wounds remaining, each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Night Scythe" id="482a-4f4e-793d-6c58" hidden="false" typeId="74f8-5443-9d6d-1f1e" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="30f2-be70-861d-1b84">This model has a transport capacity of 1 NECRONS INFANTRY unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Quantum Invader" id="1111-a91-fad5-a9ab" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be set up in the Reinforcements step of your first, second or third Movement phase, regardless of any mission rules.</characteristic>
          </characteristics>
        </profile>
