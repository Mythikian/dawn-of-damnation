        <modifier field="bd14-52e0-1f2d-e875" type="increment" value="1">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="a98a-4cc0-5f02-e078" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                <condition childId="247d-78d8-5da9-98e2" field="selections" includeChildSelections="false" scope="parent" shared="true" type="lessThan" value="1"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <selectionEntryGroups>
        <selectionEntryGroup name="Cryptek Abilities" id="92f3-c9e9-2d30-5c8f" hidden="false" sortIndex="2">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="a98a-4cc0-5f02-e078" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry name="Harbinger of Despair" id="eea9-53b5-b23e-59f5" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f07e-8852-0add-5953" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Harbinger of Despair" id="8dda-f24b-7127-8cd4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle round, at the start of a phase during your turn, you can select one enemy unit within 18&quot; of this model. That unit must make a Battle-shock test, subtracting 1 from the test when it does so.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Harbinger of Destruction" id="a03d-c6eb-7c78-1499" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ae77-5241-43e7-146c" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Harbinger of Destruction" id="e9f4-8df1-7b3d-4cd1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a model in this unit makes a ranged attack, an unmodified Hit roll of 5+ scores a Critical Hit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Living Lightning" id="a901-70f3-ac2e-5817" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a7c5-b81d-4431-4a2d" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Living Lightning" id="09c6-a765-6ebf-d08a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Shooting phase, select one enemy unit within 18&quot; of and visible to this model and roll 4 D6: for each 4+, that enemy unit suffers 1 mortal wound.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Timesplinter Mantle" id="0239-1d76-f450-d929" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ea0c-cca7-cbbc-4623" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Timesplinter Mantle" id="92e4-b021-62ca-e120" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, each time an attack targets that unit, subtract 1 from the Hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Shared abilties" id="247d-78d8-5da9-98e2" flatten="true" hidden="false" sortIndex="1">
          <selectionEntries>
            <selectionEntry name="Adaptive Strategy" id="a7d6-c417-375e-90ec" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4479-b173-1eb0-fa95" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Adaptive Strategy" id="334c-3dc6-dc54-f8ac" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model&apos;s unit is eligible to shoot and declare a charge in a turn in which it Fell Back.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Engrammatic Logic" id="b8bb-bac8-74d3-25e0" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7b98-fdf1-71d6-26ee" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Engrammatic Logic" id="7c85-e129-82a4-3972" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle, at the start of any phase, you can select one friendly ^^**Necrons**^^ unit that is Battle-shocked and within 12&quot; of this model. That unit is no longer Battle-shocked.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="My Will Be Done" id="1645-6e4c-7b6b-aa0b" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="605b-100c-e0a8-c50d" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="a98a-4cc0-5f02-e078" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
