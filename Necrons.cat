        <profile name="Flayer King" id="f9d1-4f22-ed7a-2109" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Whenever this model is leading a unit, if a model in the unit dies, until the end of the battle, add 1 to the Attacks characteristic of this models Flayer King Claws. This ability may only activate once per phase.</characteristic>
          </characteristics>
        </profile>
        <profile name="Invulnerable Save" id="d452-9ab4-600f-4a2c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Apostate of Flesh" id="b8cb-a079-6aff-1de1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Whenever this model is leading a unit, and that unit is targeted by Reanimation Protocols, you may activate this ability. If this ability is activated this models unit may reanimate 2D3 models instead but cannot be targeted by abilities that increase the amount of models restored by reanimation protocol until your next command phase. Models reanimated this way may surpass the original starting strength count of this unit. Additionally this unit may be targeted by reanimation protocol even if it is at or above starting strength.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="d3d7-3707-2fb7-aaa2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units:
■ FLAYED ONES
</characteristic>
          </characteristics>
        </profile>
