      <profiles>
        <profile name="Trigger Happy" id="5985-9b97-2315-a214" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In the shooting phase, each time a model in this unit makes an attack with a weapon that targets a unit within half that weapon’s range, the Attacks characteristic of that weapon is increased by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mining Gear" id="c246-13b1-4ccd-747b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit does not suffer movement penalties from moving over terrain.</characteristic>
          </characteristics>
        </profile>
      </profiles>
