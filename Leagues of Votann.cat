        <profile name="Skalvian Explorator" id="4c85-54bf-690e-dbc7" hidden="false" typeId="74f8-5443-9d6d-1f1e" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="30f2-be70-861d-1b84">This model has a transport capacity of 14 ^^**Leagues of Votann Infantry**^^ models. Each **^^Exoarmour, Exoframe**^^ or **^^Ironkin Steeljacks**^^ model takes up the space of 2 models. It cannot transport ^**Artillery**^^ models.</characteristic>
          </characteristics>
        </profile>
