          <profiles>
            <profile name="Bastion Shield" id="68fb-67e5-3675-c850" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a ranged attack targets the bearer’s unit, if the attacking model is within 12&quot; of the bearer’s unit, worsen the Armour Penetration characteristic of that attack by 1. If you spend 1YP, until the end of the phase, if the attacking model is within 18&quot; of the bearer’s unit, worsen the Armour Penetration characteristic of that attack by 1 instead.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
