                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of your turn, if the bearer is on the battlefield and you gained fewer than 3YP this turn, you gain an amount of YP equal to the difference.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
