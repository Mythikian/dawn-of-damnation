          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model does not suffer the penalty to its Hit rolls for making ranged attacks while enemy units are within Engagement Range of it.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged: 1-8 wounds remaining" id="9748-d34a-d4ae-2ce0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-8 wounds remaining, subtract 4 from its Objective Control characteristic and each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Transport" id="e6af-e117-d2fd-e8c6" hidden="false" typeId="74f8-5443-9d6d-1f1e" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="30f2-be70-861d-1b84">This model has a transport capacity of 22 Leagues of Votann Infantry models. Each **^^Exoarmour, Exoframe**^^ or **^^Ironkin Steeljacks**^^ model takes up the space of 2 models. Each **^^Vartijan Exo-Driller^^** model takes up the space of 3 models. It cannot transport Artillery models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
