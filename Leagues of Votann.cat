    <selectionEntryGroup name="White Dwarf Crusade Relics" id="b1c7-1af3-4cc7-7580" collapsible="true" hidden="false">
      <comment>Crusade content</comment>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="c00c-b9d6-e0f7-4c37" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="lessThan" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <selectionEntryGroups>
        <selectionEntryGroup name="Antiquity Relics" id="5e23-a981-6000-7944" hidden="false" sortIndex="2">
          <selectionEntries>
            <selectionEntry name="The Captive Abyss" id="673e-fb48-f9a8-6d3b" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6946-f201-716d-8091" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="2"/>
                <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="1"/>
                <cost name="Diplomatic Power" typeId="4d7c-04b6-8a79-837f" value="0"/>
                <cost name="Military Power" typeId="1cbe-d9c9-86a8-2d41" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition childId="673e-fb48-f9a8-6d3b" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
                            <condition childId="673e-fb48-f9a8-6d3b" field="selections" includeChildForces="true" includeChildSelections="true" scope="parent" shared="true" type="lessThan" value="1"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                      <conditions>
                        <condition childId="any" field="a623-fe74-1d33-cddf" includeChildSelections="true" scope="root-entry" shared="true" type="lessThan" value="31"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
                <modifier field="b03b-c239-15a5-da55" type="set" value="2">
                  <conditions>
                    <condition childId="5929-ad51-d006-e008" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="The Captive Abyss" id="ce27-b3ca-65ff-2427" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle, in your Shooting phase, if the bearer&apos;s unit has not shot this phase, the bearer can use this relic. If it does, until the end of the phase, the bearer has the **^^Grenades^^** keyword. In addition, until the end of the phase, when you target the bearer&apos;s unit with the Grenade Stratagem, add 1 to the dice roll to determine whether the enemy unit suffers a mortal wound for each Judgement token that enemy unit has.
***Data Author Note: Judgement tokens were removed with the release of the codex.***</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
