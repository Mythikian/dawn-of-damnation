              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Ranged weapons equipped by models in this unit have the **[SUSTAINED HITS 1]** ability.</characteristic>
              </characteristics>
            </profile>
          </profiles>
