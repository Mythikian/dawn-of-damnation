              </modifiers>
            </modifierGroup>
          </modifierGroups>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="680e-ccbe-ca8c-ffc3" field="selections" scope="root-entry" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Extra Armour" id="4708-fe51-d823-72c5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
