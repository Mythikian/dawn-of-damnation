    <selectionEntry name="Medi-pack" id="b9c9-d718-30ba-a99a" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Medi-pack" id="b8e3-1e1f-b58b-1ca0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, if the bearer&apos;s unit is below its Starting Strength, you can return up to D3 destroyed **^^Platoon^^** (excluding **^^Characters^^**) to this unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Master vox" id="1f75-a238-cc23-a70f" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Master Vox" id="2065-a298-ad3c-9479" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time the **^^Officer^^** in the bearer’s unit issues an Order, it can issue it to an eligible unit up to 24&quot; away.</characteristic>
          </characteristics>
          <modifiers>
            <modifier arg="24&quot; away." field="9b8f-694b-e5e-b573" type="replace" value="12&quot; away, and Walls and closed Hatchways are ignored when doing so.">
              <conditions>
                <condition childId="1d6e-2579-8e7f-1ed4" field="selections" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </selectionEntry>
