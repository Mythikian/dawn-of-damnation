      <modifierGroups>
        <modifierGroup type="and">
          <comment>Boarding Actions modifiers</comment>
          <modifiers>
            <modifier field="error" type="add" value="Cannot take 2 support Characters in an Embarked Regiment">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditionGroups>
                    <conditionGroup min="2" type="count">
                      <conditions>
                        <condition childId="cf38-2338-aa71-ed56" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
                        <condition childId="1a39-50fb-5af6-e77" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
                        <condition childId="2f53-8ca8-fcd2-b526" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
