                <profile name="Omnissian Unguents (Aura)" id="3f15-9407-875e-1a5c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Astra Militarum Tech‑Priest Enginseer^^** model only. While a friendly **^^Armoured Skirmisher^^** unit is within 3&quot; of the bearer, that unit has the Feel No Pain 5+ ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Grand Strategist" id="467f-efca-7dce-54bc" hidden="false" import="true" type="upgrade">
