        <profile name="Unwavering Loyalty" id="77d8-0a56-5ad3-02e2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Whilst a friendly Astra Militarum unit is affected by this models orders, that unit may reroll any Battle-shock test that unit makes.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wreathed in Flame" id="9872-f553-324d-b07d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">All ranged weapons equipped by models in this unit gain [Lethal Hits].</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord General Militant" id="9670-533a-3b2f-249f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this model is in your army, it must be your **^^Warlord^^**.</characteristic>
