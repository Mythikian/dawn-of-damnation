              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Sly Marbo" id="1f34-96c4-2558-827d" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6&quot;</characteristic>
