      <profiles>
        <profile name="Orders" id="85b7-65b8-1961-50ee" hidden="false" typeId="3fc9-16d8-8670-c8e2" typeName="Orders">
          <characteristics>
            <characteristic name="Orders" typeId="36b-c3c9-245f-e97d">This **^^Officer^^** can issue up to 3 Orders to **^^Regiment^^** units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord Castellan" id="ce98-50ed-b988-7a96" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, that unit can be affected by up to two different Orders at the same time.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tactical Genius" id="bb4d-65d3-bef6-db21" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle round, one unit from your army with this ability can use it when a friendly **^^Regiment^^** unit within 12&quot; of that model is targeted with a Stratagem. If it does, reduce the CP cost of that usage of that Stratagem by 1 CP.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1d6e-2579-8e7f-1ed4" field="selections" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Ursula Creed" id="db2d-5519-21e4-bda1" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
