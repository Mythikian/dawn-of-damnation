        <profile name="The Immortal Hand of Steel" id="b2d1-e46c-1be3-a765" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The first time this model is destroyed, at the end of the phase, roll one D6: on a 2+, set this model back up on the battlefield as close as possible to where it was destroyed and not within Engagement Range of any enemy units, with 4 wounds remaining.</characteristic>
          </characteristics>
        </profile>
        <profile name="Slayer of Giants" id="15ee-f01f-5fb4-3cdb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a ranged attack made by a model in this unit targets a MONSTER or VEHICLE model, you can re-roll hit rolls of 1, you can re-roll wound rolls of 1 and you can re-roll the Damage roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Vox-net" id="187c-0251-5fc1-f975" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
