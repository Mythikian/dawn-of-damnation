                <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="0"/>
                <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="0"/>
                <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0"/>
                <cost name="Crusade: Weapon Modifications" typeId="716d-91b7-d55a-1022" value="0"/>
                <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0"/>
                <cost name="Logistics Points" typeId="04b1-67f7-48cb-4f1f" value="0"/>
                <cost name="Commendation Points" typeId="e969-59de-fdb7-7c4e" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="e4d8-c6a1-7c23-ae25" childName="Officer" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Grand Strategist" id="4d4d-707e-5dd6-2e81" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Officer^^** model only. After both players have deployed their armies, if the bearer’s unit (or any **^^Transport^^** it is embarked within) is on the battlefield, select up to two units with the **^^Regiment^^** or **^^Squadron^^** keywords from your army and redeploy them. When doing so, you can set those units up in Strategic Reserves, regardless of how many units are already in Strategic Reserves.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Exemplary Officer" id="0691-f2dc-f688-bbe2" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="feef-baea-cd50-dff4" field="selections" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="77ff-dc99-29c2-ddeb" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="20"/>
                <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="0"/>
                <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="0"/>
                <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0"/>
                <cost name="Crusade: Weapon Modifications" typeId="716d-91b7-d55a-1022" value="0"/>
                <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0"/>
                <cost name="Logistics Points" typeId="04b1-67f7-48cb-4f1f" value="0"/>
                <cost name="Commendation Points" typeId="e969-59de-fdb7-7c4e" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="cf47-a0d7-7207-29dc" childName="Infantry" field="selections" scope="root-entry" shared="true" type="notInstanceOf" value="1"/>
                        <condition childId="e4d8-c6a1-7c23-ae25" childName="Officer" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Exemplary Officer" id="543d-5f5d-746f-0fdf" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Infantry Officer^^** model only. Each time the bearer issues an Order to its own unit, you can select up to two other **^^Platoon^^** units within 3&quot; of the bearer’s unit. That Order is also issued to each of those units.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Master Manoeuvrist" id="9a82-eebc-f495-1889" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="be1a-cbe0-d1ab-bd7c" field="selections" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="b538-0364-ce39-639b" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="15"/>
                <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="0"/>
                <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="0"/>
                <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0"/>
                <cost name="Crusade: Weapon Modifications" typeId="716d-91b7-d55a-1022" value="0"/>
                <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0"/>
                <cost name="Logistics Points" typeId="04b1-67f7-48cb-4f1f" value="0"/>
                <cost name="Commendation Points" typeId="e969-59de-fdb7-7c4e" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="cf47-a0d7-7207-29dc" childName="Infantry" field="selections" scope="root-entry" shared="true" type="notInstanceOf" value="1"/>
                        <condition childId="e4d8-c6a1-7c23-ae25" childName="Officer" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Master Manoeuvrist" id="4db4-5acf-3741-ac29" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Infantry Officer^^** model only. At the end of your opponent’s Fight phase, if the bearer’s unit is not within Engagement Range of one or more enemy units and every model in that unit is within 3&quot; of an **^^Astra Militarum Transport^^** from your army, it can embark within that **^^Transport^^**.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntryGroup>
