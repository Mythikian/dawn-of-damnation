        <profile name="Aura of Ultimate Prestige" id="c0e0-5ebd-d5e8-3771" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">All friendly units within 18&quot; of this model may reroll battle-shock tests.</characteristic>
          </characteristics>
        </profile>
        <profile name="Rolling Fortress" id="0454-afba-edce-b8d8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a ranged attack is allocated to an Astra Militarum model from your army, if that model is not fully visible to every model in the attacking unit because of this Fortress of Arrogance model, that model has the Benefit of Cover against that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Force Field" id="642c-83dd-22d1-2ac5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per game at the start of any phase, you may activate this ability, if you do for the rest of the phase this model has a 4+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged: 1-8 Wounds Remaining" id="99e8-5a7d-8ad6-6c24" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-8 wounds remaining, subtract 4 from its Objective Control characteristic and each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
          </characteristics>
        </profile>
