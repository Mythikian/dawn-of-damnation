        <profile name="Stalwart Sacrifice" id="e090-7505-277a-af95" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the beginning of your shooting phase, select up to 3 units within 12&quot; of this model&apos;s unit. those units must make a leadership test. If failed, until your next shooting phase, or if this unit is destroyed, that unit can only declare this unit as the target for any attacks. This models unit additionally has a 5+ invulnerable save against attacks made by those units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Orders" id="4794-6386-c60d-38d2" hidden="false" typeId="3fc9-16d8-8670-c8e2" typeName="Orders">
          <characteristics>
            <characteristic name="Orders" typeId="36b-c3c9-245f-e97d">This **^^Officer^^** can issue up to 3 Orders to **^^Regiment^^** units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="8d5f-d878-ed92-8283" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following unit:
- **^^Valhallan Ice Warriors**^^</characteristic>
          </characteristics>
        </profile>
        <profile name="Summary Execution" id="96cf-b522-8c1e-b999" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle round, at the start of any phase, you can select one friendly Astra Militarum Infantry unit that is Battle-shocked and within 12&quot; of this model. If you do, one model in that unit is destroyed, and that unit is then no longer Battle-shocked.</characteristic>
          </characteristics>
        </profile>
      </profiles>
