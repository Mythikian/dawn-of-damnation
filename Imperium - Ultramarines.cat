      <profiles>
        <profile name="Peritarch Targeter" id="5d02-dba9-3299-f9ad" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Shooting phase, you can select one enemy unit within 36&quot; and visible to this model. Until the end of the phase, that unit cannot have the Benefit of Cover.</characteristic>
          </characteristics>
        </profile>
        <profile name="Firing Protocol" id="8ad9-05c0-ff05-fad7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Models in this unit are eligible to shoot their Cyclone missile launchers even while they are in engagement range of one or more enemy units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Attached Unit" id="23ff-b573-4403-8545" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If a unit from your army with the Leader ability can be attached to a TERMINATOR SQUAD, it can be attached to this unit instead.</characteristic>
          </characteristics>
        </profile>
      </profiles>
