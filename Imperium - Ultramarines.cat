          <characteristics>
            <characteristic name="Capacity" typeId="30f2-be70-861d-1b84">This model has a transport capacity of 12 ADEPTUS ASTARTES INFANTRY models. Each Jump Pack, Gravis or Terminator model takes up the space of 2 models. Each Centurion model takes up the space of 3 models.</characteristic>
          </characteristics>
        </profile>
