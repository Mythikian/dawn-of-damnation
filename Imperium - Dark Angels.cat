        <profile name="Talonmaster" id="9b3-3b90-f48c-380e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3&quot; of one or more other friendly Adeptus Astartes Mounted or Adeptus Astartes Fly Vehicle units, this model has the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Nowhere To Hide" id="e40d-a580-8e1f-cd2a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly Adeptus Astartes Mounted or Adeptus Astartes Fly Vehicle unit is within 6&quot; of this model, ranged weapons equipped by models in that unit have the [IGNORES COVER] ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of Manoeuvre" id="fdde-d4a-774c-9306" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per turn, when an enemy unit ends a Normal, Advance or Fall Back move within 9&quot; of this model, if this model is not within Engagement Range of one or more enemy units, this model can make a Normal move of up to 6&quot;.</characteristic>
          </characteristics>
        </profile>
        <profile name="Invulnerable Save" id="1431-e0c7-d73-19e5" hidden="false" page="35" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
