        <profile name="Iron Hands Bodyguard" id="f582-7ac1-9aab-6efb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3&quot; of one or more ^^**Adeptus Astartes Infantry^^** or ^^**Iron Hands**^^ units, this model has [Lone Operative].</characteristic>
          </characteristics>
        </profile>
        <profile name="Eye of the Storm" id="7636-3386-4790-64b2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, select up to three friendly ^^**ADEPTUS ASTARTES**^^ units within 12&quot; and line of sight of this model. For each selected unit, choose one of the Eye of the Storm effects in the Eye of the Storm table. Until the start of your next Command phase, that unit is affected by the chosen effect. A unit can only be affected by one Eye of the Storm effect at a time. No two Units in your army may have the same Eye of the Storm effect at the same time.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fierce Winds" id="ce3a-efec-ae44-0bbc" hidden="false" typeId="cef5-02e9-94c5-e093" typeName="Eye of the Storm">
          <characteristics>
            <characteristic name="Effect" typeId="c5a6-d6b0-0f90-b771">Whenever this unit makes an advance roll, you can choose to re-roll it.</characteristic>
          </characteristics>
        </profile>
        <profile name="Steel Haze" id="5a0d-ef8b-796b-436d" hidden="false" typeId="cef5-02e9-94c5-e093" typeName="Eye of the Storm">
          <characteristics>
            <characteristic name="Effect" typeId="c5a6-d6b0-0f90-b771">^^**Adeptus Astartes Infantry^^** only. This unit gains [Stealth].</characteristic>
          </characteristics>
        </profile>
        <profile name="Cut Deep" id="c9ac-824c-6c4b-3c82" hidden="false" typeId="cef5-02e9-94c5-e093" typeName="Eye of the Storm">
          <characteristics>
            <characteristic name="Effect" typeId="c5a6-d6b0-0f90-b771">^^**Adeptus Astartes Infantry^^** only. Ranged weapons equipped by models in this unit gain [Sustained Hits 1].</characteristic>
          </characteristics>
        </profile>
      </profiles>
