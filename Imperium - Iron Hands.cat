        <profile name="Tarantula Mobile Battery" id="2b13-0790-507f-f20d" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6&quot;</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">6</characteristic>
            <characteristic name="SV" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">4</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Loyal Protector" id="5a27-d78a-f5d2-9f15" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Declare Battle Formations step, this model must join one Techmarine unit from your army (a Techmarine cannot have more than one Loyal Protector model joined to it). This model then counts as part of that Techmarine for the rest of the battle, and its Starting Strength is increased accordingly. If it is not possible to join this model to a Techmarine, it does not take part in the battle and counts as having been destroyed.
While this model is joined to a unit, it can embark within any Transport that unit can embark within, and takes up the space of 2 models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tarantula Support" id="a435-49c3-8a54-7cce" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a Techmarine model is in the same unit as this model, if that Techmarine has LONE OPERATIVE, this model also has LONE OPERATIVE. This model cannot be selected as your Warlord and cannot be given Enhancements.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tarantula Bodyguard" id="539f-d5b6-dc42-6118" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a Techmarine model is in the same unit as this model, the Techmarine model has a Feel No Pain 5+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
