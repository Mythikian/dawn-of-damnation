        <profile name="Forge Master" id="5a40-a833-e3a7-201d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3&quot; of one or more friendly Adeptus Astartes Vehicle units, this model has the Lone Operative ability</characteristic>
          </characteristics>
        </profile>
        <profile name="Omnissian Sacrifice" id="e6fc-7987-7a26-c5df" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When wounds are allocated to a friendly Adeptus Astartes Vehicle model within 3&quot; of this model you may chose to use this ability. If you do this model takes the wounds instead of the vehicle with a [Feel No Pain 5+]. Wounds reallocated this way must come from a weapon that has a Strength characteristic of 9 or below.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Purity of the Machine" id="669b-84cb-984a-4a34" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly Adeptus Astartes Vehicle unit is within 3&quot; of this model, add 2 to any advance or charge rolls that vehicle makes.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="cf42-23d7-aecb-6826" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units:

■ Assault Intercessor Squad
■ Desolation Squad
■ Devastator Squad
■ Intercessor Squad
■ Tactical Squad</characteristic>
          </characteristics>
        </profile>
      </profiles>
