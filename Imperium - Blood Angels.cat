        </profile>
        <profile name="The Shield of Baal" id="8c7d-7720-02a0-2135" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, models in that unit add 1 to their Objective Control characteristic and each time a model in that unit makes an attack, you can re-roll a Hit roll of 1.</characteristic>
          </characteristics>
        </profile>
