        <profile name="Corinthine Warplate" id="613a-52df-2dbc-7783" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time an attack targets this model, worsen the Armour Penetration characteristic of that attack by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Custodes Bodyguard" id="b23d-b93b-9ef3-17e6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3&quot; of one or more friendly ^^**Adeptus Custodes Infantry**^^ units, this unit has the [Lone Operative] ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="First of the Ten Thousand" id="2050-e152-0265-d396" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this model is in your army, it must be your ^^**WARLORD**^^.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of the Ten Thousand" id="71b2-1dc3-5feb-b7b6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, select two ^^**Master of the Ten Thousand**^^ abilities. Until the start of your next Command phase, this model has those abilities.</characteristic>
          </characteristics>
        </profile>
        <profile name="Emperor’s Chosen" id="219d-ee2d-8d05-49dc" hidden="false" typeId="18fc-30d5-1277-ed95" typeName="Master of the Ten Thousand">
          <characteristics>
            <characteristic name="Ability" typeId="a363-ea73-3f28-f977">While a friendly ^^**ADEPTUS CUSTODES INFANTRY**^^ unit is within 6” of this model: That unit has a 6+ Feel No Pain. If it already has a Feel No Pain, improve it by +1 (to a maximum of 4+).</characteristic>
          </characteristics>
        </profile>
        <profile name="Golden Phalanx" id="c811-a9d2-648b-6c10" hidden="false" typeId="18fc-30d5-1277-ed95" typeName="Master of the Ten Thousand">
          <characteristics>
            <characteristic name="Ability" typeId="a363-ea73-3f28-f977">^^**ADEPTUS CUSTODES INFANTRY**^^ units within 6&quot; of this model improve their Objective Control characteristic by 3.</characteristic>
          </characteristics>
        </profile>
        <profile name="Perfect Discipline" id="c3c3-6b27-712c-ad5e" hidden="false" typeId="18fc-30d5-1277-ed95" typeName="Master of the Ten Thousand">
          <characteristics>
            <characteristic name="Ability" typeId="a363-ea73-3f28-f977">Once per phase, all ^^**ADEPTUS CUSTODES**^^ units within 6&quot; may re-roll one Hit or one Save roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
