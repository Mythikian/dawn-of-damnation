  <sharedInfoGroups>
    <infoGroup name="Talons" id="1cd2-aeaf-6c00-ec0" hidden="false">
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="757a-b5ed-a43f-3cdd" field="selections" includeChildSelections="true" scope="force" shared="true" type="lessThan" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Null Aegis (Aura)" id="2048-15a2-ecb8-1709" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While an ^^**Adeptus Custodes^^** unit is within 6&quot; of this unit, models in that unit have the Feel No Pain 5+ ability against Psychic Attacks and mortal wounds.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="9177-5477-63dd-38d" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Deadly Unity (Aura)" id="5678-aeb6-f682-8a75" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While an **^Anathema Psykana^^** unit is within 6&quot; of this unit, each time a model in that ^^**Anathema Psykana^^** unit makes an attack, add 1 to the Hit roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="9177-5477-63dd-38d" field="selections" includeChildSelections="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </infoGroup>
  </sharedInfoGroups>
  <sharedProfiles>
    <profile name="Daughter of the Abyss" id="b95d-04e9-97fd-4125" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" id="f5f-2854-9667-9cbe" hidden="false" typeId="9b8f-694b-e5e-b573">This model has the Feel No Pain 3+ ability against Psychic Attacks and mortal wounds.</characteristic>
      </characteristics>
    </profile>
    <profile name="Invulnerable Save" id="e3cf-4870-44cf-74da" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <comment>5+</comment>
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a 5+ invulnerable save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Invulnerable Save" id="4042-b2c1-d581-dbe7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <comment>Single model 4+</comment>
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a 4+ invulnerable save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Praesidium Shield" id="2184-10e8-fe1e-9731" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" id="28bc-ca42-3d02-4d96" hidden="false" typeId="9b8f-694b-e5e-b573">Add 1 to the bearer&apos;s Wounds characteristic.</characteristic>
      </characteristics>
    </profile>
    <profile name="Vexilla" id="ac43-e2b3-63cb-ecb2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 1 to the Objective Control characteristic of models in the bearer&apos;s unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Strategic Mastery" id="5a38-d608-89c4-6377" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle round, one unit from your army with this ability can use it when its unit is targeted with a Stratagem. If it does, reduce the CP cost of that use of that Stratagem by 1CP.</characteristic>
      </characteristics>
    </profile>
    <profile name="Invulnerable Save" id="0300-84b9-69cf-b64f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <comment>Unit 4+</comment>
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Models in this unit have a 4+ invulnerable save.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Martial Ka&apos;tah" id="e348-7090-3aff-ee2c" hidden="false">
      <description>Each time a unit with this ability is selected to fight, select one of the Ka&apos;tah stances below. Until that unit has finished making its attacks, the selected Stance is active for it and it gains the relevant ability.

■ DACATARAI STANCE
Melee weapons equipped by models in this unit have the [SUSTAINED HITS 1] ability.
■ RENDAX STANCE
Melee weapons equipped by models in this unit have the [LETHAL HITS] ability.</description>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="d55b-94a6-3265-fa09" field="selections" includeChildSelections="true" scope="model-or-unit" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
    </rule>
  </sharedRules>
