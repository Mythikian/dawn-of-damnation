    <selectionEntryGroup name="Endeavour Imperatives" id="e169-0af6-3c47-f404" defaultSelectionEntryId="none" flatten="false" hidden="false">
      <comment>Crusade content</comment>
      <selectionEntries>
        <selectionEntry name="Inspirational Example" id="80a8-9b38-3fc0-0d7b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="50c2-2871-92a5-f9a1" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Inspirational Example" id="551f-de4c-fd13-8138" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of the battle, two or more enemy units were destroyed by melee attacks made by an **^^Adeptus Custodes Character^^** model from your Crusade army.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Emperor&apos;s Domain" id="98c0-1678-d9f3-485f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2791-06a7-7373-9b2f" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Emperor&apos;s Domain" id="6d88-f060-015b-b91e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Complete two battles where, at the end of the battle, you have more friendly units wholly within your deployment zone than enemy units (excluding **^^Aircraft^^**).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Wrath of the Emperor" id="8c6e-3aa3-3fb7-f1c6" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2880-5b15-6dd0-df21" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Wrath of the Emperor" id="e326-b9b9-9606-dccd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Complete two battles in which you have destroyed four or more units by the start of the third battle round.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Make An Example" id="2dea-e2fd-b1f2-ed21" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="be73-3002-46b1-850b" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Make An Example" id="c904-82f7-8fbe-98f3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Win a battle by more than 10 Victory points.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vital Targets" id="702b-e961-c8a1-684d" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0c87-d7d0-d5bb-8a3b" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Vital Targets" id="fd1c-0dd1-51d5-a09e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Complete two battles in which you destroy the three units from your opponent&apos;s army with the highest points values (if one or more units are tied in this way, then the destruction of any of them counts towards this Imperative).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Shadowed Directive" id="536e-5bc5-ac9c-c9fa" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4e18-9a5c-8dd4-c3c7" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Shadowed Directive" id="5b7d-fce8-cbac-6ee0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Complete two battles in which you earned XP from an **^^Adeptus Custodes^^** Agenda.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Absolute Mastery" id="a807-7ef2-c1cb-07c0" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b862-edea-4b07-a4aa" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Absolute Mastery" id="cfb6-aa7a-f3b2-c7b2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Complete two battles in which you earned XP from non-**^^Adeptus Custodes^^** Agendas (such as those found in the main Crusade rules).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Shadow of the Throne" id="4dbd-ba29-a9d0-e8c4" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1832-0cb4-542f-95c0" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Shadow of the Throne" id="a28d-5fcd-7bed-45f1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of the battle, both of the following are satisfied:
- You control three or more objective markers.
- You control at least double the number of objective markers that your opponent does.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Martial Supremacy" id="ba0e-e289-38b7-5024" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7262-dbf4-4b19-155e" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Martial Supremacy" id="371f-1f14-aa94-4423" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of a battle, at least twice as many enemy units were destroyed in that battle than units from your Crusade army.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Alpha Threat Confirmed" id="6a28-798c-48e3-8bb7" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3d3d-ed4f-4ac4-1243" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Alpha Threat Confirmed" id="d6da-3e59-a04f-3589" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of a battle, the enemy **^^Warlord^^** is destroyed.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Annihilation" id="11bc-69e7-1e16-089d" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="86e8-1db1-977e-7104" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Annihilation" id="f2c5-060a-f70b-f4a2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of a battle, every enemy unit is destroyed, or is Below Half-strength.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Emperor&apos;s Will Be Done" id="4d70-1a85-0d87-881a" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7bc1-2619-465e-8390" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
