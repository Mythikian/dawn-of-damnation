              <profiles>
                <profile name="Ferocious Show Off" id="4960-b1d4-a81d-1d5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Orks Infantry^^** model only. Each time the bearer fights, while resolving those attacks, add 1 to the Strength characteristic of the bearer&apos;s melee weapons. If the bearer&apos;s unit contains 10 or more models, while resolving those attacks, add 3 to the Strength characteristic instead.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Brutal But Kunnin&apos;" id="2297-d724-700d-9821" hidden="false" import="true" type="upgrade">
