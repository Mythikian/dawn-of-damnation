                <profile name="Speed Makes Right" id="953d-e226-da82-795" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Orks^^** model only. In your Command phase, if the bearer (or a **^^Transport^^** the bearer is embarked within) is within 9&quot; of one or more enemy units, roll one D6; on a 3+, you gain 1CP.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Wazblasta" id="39b9-3bd2-8696-8a31" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b456-1c32-cfcd-3cf6" field="selections" includeChildForces="false" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="10"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition childId="39b9-3bd2-8696-8a31" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
                            <condition childId="39b9-3bd2-8696-8a31" field="selections" includeChildForces="true" includeChildSelections="true" scope="parent" shared="true" type="lessThan" value="1"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                      <conditions>
                        <condition childId="1b8c-203a-e329-2a02" field="selections" scope="parent" shared="true" type="notInstanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Wazblasta" id="d84c-a22f-ef3-126c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Deffkilla Wartrike^^** model only. In your Shooting phase, after the bearer&apos;s unit has shot, if it is not within Engagement Range of one or more enemy units, it can make a Normal move of up to 6&quot;. If it does, until the end of the turn, it is not eligible to declare a charge.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
