          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a GRETCHIN unit is within 6&quot; of this model, that unit’s Thievin’ Scavengers ability is successful on D6 rolls of 2+, instead of rolls of 4+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
