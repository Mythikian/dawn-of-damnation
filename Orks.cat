          <characteristics>
            <characteristic name="Capacity" id="d254-4c8-d9f4-829b" hidden="false" typeId="30f2-be70-861d-1b84">This model has a transport capacity of 11 ORKS INFANTRY models (excluding GHAZGHKULL THRAKA). Each MEGA ARMOUR or JUMP PACK model takes up the space of 2 models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
