      <selectionEntries>
        <selectionEntry name="Thunderous Dakkastorm" id="f7e6-6ed8-ed52-2700" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Thunderous Dakkastorm" id="0a95-5237-1802-3c98" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Shooting phase, after this model has shot, select on enemy unit hit by one or more of those attacks; that unit must take a Battle-shock test.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Dok&apos;s Toolz" id="b6e4-d9c9-f8e3-b13f" hidden="false" import="true" type="upgrade">
          <infoLinks>
            <infoLink name="Feel No Pain" id="ad6e-4a10-70e5-572a" hidden="false" targetId="9bf4-280f-bbe2-6fbb" type="rule">
