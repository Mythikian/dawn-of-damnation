                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Orks Infantry^^** model only. While the bearer is leading a unit, that unit always counts as containing 10 or more models for the purposes of your Detachment rule and any Stratagems you use.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
