        <profile name="Shoutin’ Pole (Aura)" id="69a-6435-91dc-1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly ORKS unit is within 6&quot; of this FORTIFICATION, improve the Leadership characteristic of models in that unit by 1.</characteristic>
          </characteristics>
        </profile>
