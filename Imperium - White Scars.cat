          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If a unit from your army with the Leader ability can be attached to an Outrider Squad, it can be attached to this unit instead. Any CHARACTER that joins this unit gains FLY.</characteristic>
          </characteristics>
        </profile>
