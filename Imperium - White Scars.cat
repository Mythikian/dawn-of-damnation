        <profile name="Talaskar Strength" id="cb22-bd40-9d43-b6c2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, select two Talaskar Strength abilities. Until the start of your next Command phase, this model has those abilities.</characteristic>
          </characteristics>
        </profile>
        <profile name="White Scars Bodyguard" id="6a64-4cf0-1980-82be" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3&quot; of one or more friendly Adeptus Astartes Infantry units, this model has the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Manhunters [Aura]" id="fb85-6163-c82c-d5d0" hidden="false" typeId="354c-7acb-7216-7513" typeName="Talaskar Strength">
          <characteristics>
            <characteristic name="Ability" typeId="4848-260d-9723-fe2d">If a friendly Adeptus Astartes within 6&quot; makes an advance roll, after that roll is made you may replace that roll with a 4.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fierce Brutality" id="fd62-464a-7c82-f882" hidden="false" typeId="354c-7acb-7216-7513" typeName="Talaskar Strength">
          <characteristics>
            <characteristic name="Ability" typeId="4848-260d-9723-fe2d">Each time a model in this unit makes a melee attack, if this unit made a Charge move this turn, improve the Attacks and Strrength characteristic of that attack by 1</characteristic>
          </characteristics>
        </profile>
        <profile name="Men of Stories" id="c3c3-5297-1f02-ab29" hidden="false" typeId="354c-7acb-7216-7513" typeName="Talaskar Strength">
          <characteristics>
            <characteristic name="Ability" typeId="4848-260d-9723-fe2d">Whenever an enemy Character or Monster model is destroyed, you gain 1 Command Point.</characteristic>
