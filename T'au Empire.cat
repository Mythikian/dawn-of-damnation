                    <condition childId="cd97-19b6-3957-4c78" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                    <condition childId="205d-dcad-4d0-ccae" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                    <condition childId="d372-6d2c-2df2-8e91" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
