            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry name="Missile pod" id="3535-5405-3607-1574" collective="true" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="72b1-601d-3c4e-bb37" field="selections" scope="parent" shared="true" type="min" value="1"/>
