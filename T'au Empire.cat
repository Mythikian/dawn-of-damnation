                  <profiles>
                    <profile name="Ambushed" id="c439-255b-1470-91d2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the first turn, your **^^Warlord^^** suffers D3 mortal wounds.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Betrayed" id="afad-4819-0eb8-b946" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Betrayed" id="1e48-7041-6bd0-5f14" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of this battle, each time a unit from your army takes an Out of Action test, subtract 1 from that test.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Waylaid" id="60e7-9d2e-3f41-b9db" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Waylaid" id="e1e9-2785-8f17-4a09" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Declare Battle Formations step, randomly select one unit from your Crusade army that is not in Reserves. You must place that unit into Strategic Reserves, regardless of how many units are already in Strategic Reserves.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Doubting the Pact" id="1ec4-be82-6943-47a7" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Doubting the Pact" id="c032-b583-acdd-e695" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Your opponent can have the following rule:
**Having Doubts:** Once per battle, at the start of the Command phase, you can use this rule. If you do, select one enemy unit and roll one D6. On a 2+, that unit is Battle-shocked.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Isolated" id="9cdd-383c-601a-a68f" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Isolated" id="83a9-4f31-c691-c760" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You cannot set up units from Reserves in the first or second battle round.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Outmatched" id="e7b7-de22-11ed-f685" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Outmatched" id="2ca7-839c-faef-f73d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Your opponent starts the battle with 1CP.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntryGroup>
