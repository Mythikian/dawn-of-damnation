            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">3</characteristic>
            <characteristic name="SV" typeId="450-a17e-9d5e-29da">6+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">3</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
          </characteristics>
        </profile>
        <profile name="Neural Overload (Psychic)" id="fcdd-2fec-ac51-1c22" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Shooting phase, select one enemy unit within 18&quot; and visible to this model. Roll a D6: 1: The Nagi suffers 1 Mortal Wound. 2-5: The target unit subtracts 1 from its hit rolls until the start of the next turn. 6: The target unit suffers D3 Mortal Wounds and subtracts 1 from its hit rolls until the start of the next turn. Leader: This model can be attached to the following units:</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="3b0c-81f3-26a9-14b4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units:
- **^^Breacher Team^^**
- **^^Strike Team^^**

You can attach this model to a unit, even if one Ethereal model has already been attached to it. If you do, and that Bodyguard unit is destroyed, the Leader units attached to it become separate units, with their original Starting Strengths.</characteristic>
          </characteristics>
        </profile>
      </profiles>
