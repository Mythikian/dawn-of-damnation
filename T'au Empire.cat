          </constraints>
          <modifiers>
            <modifier field="a9f4-34b8-14df-e939" type="set" value="1">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="cd97-19b6-3957-4c78" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
