        <profile name="Damaged: 1-5 Wounds Remaining" id="9b21-f9e4-2fe9-7895" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <comment>Stormsurge</comment>
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-5 wounds remaining, subtract 3 from this models Objective Control characteristic, and each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Heavy Walker" id="d152-5323-f05c-bd84" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time this model makes a Normal, Advance or Fall Back move, it can move over models (excluding TITANIC models) and terrain features that are 4&quot; or less in height as if they were not there.</characteristic>
          </characteristics>
        </profile>
        <profile name="Support System" id="d61e-c391-27c4-cec9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time this model makes a ranged attack, you can ignore any or all modifiers to the Hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Titan-killer" id="f200-bc51-2065-ca29" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time this model makes a ranged attack that targets a TITANIC or TOWERING unit, you can re-roll the Hit roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
