        <profile name="Orbital Comms Array (Aura)" id="6bb3-5fb3-66ec-cd6d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly T&apos;AU EMPIRE unit is within 6&quot; of this FORTIFICATION, each time you target that unit with a Stratagem, roll one D6: on a 5+, you gain 1CP.</characteristic>
          </characteristics>
        </profile>
        <profile name="Reinforced Cover" id="8e52-4874-7ed0-287d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a ranged attack is allocated to a model, if that model is not fully visible to every model in the attacking unit because of this FORTIFICATION, that model has the Benefit of Cover against that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
