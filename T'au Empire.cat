    </selectionEntryGroup>
    <selectionEntryGroup name="Detachment" id="635f-4f21-95c7-35e7" defaultSelectionEntryId="none">
      <constraints>
        <constraint id="b27-2395-910d-8372" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="fa78-6df5-230f-2b4" field="selections" scope="parent" shared="true" type="min" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Kauyon" id="e366-3583-f47a-986e" import="true" type="upgrade">
          <infoLinks>
            <infoLink name="Sustained Hits" id="f7b-c18-c364-a52" hidden="false" targetId="1897-c22c-9597-12b1" type="rule"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1d6e-2579-8e7f-1ed4" field="selections" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Patient Hunter" id="317c-3f1d-9993-b610" hidden="false">
              <description>During the third, fourth, and fifth battle rounds, ranged weapons equipped by **^^T’au Empire^^** models from your army have the **[SUSTAINED HITS 1]** ability. During the third, fourth and fifth battle rounds, while a unit is a Guided unit (see For the Greater Good), each time a ranged attack is made by a model in that unit that targets a Spotted unit, you can ignore any or all modifiers to that attack’s Ballistic skill characteristics and/or all modifiers to the Hit roll.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Mont&apos;ka" id="6aea-8ba5-978e-8def" import="true" type="upgrade">
          <infoLinks>
            <infoLink name="Assault" id="634a-8ea4-171-296a" hidden="false" targetId="fc8a-8c24-bae9-cc1c" type="rule"/>
            <infoLink name="Lethal Hits" id="1950-5e28-9ebc-5958" hidden="false" targetId="d1d1-611e-5191-1095" type="rule"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1d6e-2579-8e7f-1ed4" field="selections" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Killing Blow" id="f9d3-b36b-e093-4fb4" hidden="false">
              <description>During the first, second and third battle rounds, ranged weapons equipped by **^^T’au Empire^^** models from your army have the **[ASSAULT]** ability. During the first, second and third battle rounds, while a unit is a Guided unit (see For the Greater Good), its ranged weapons have the **[LETHAL HITS]** ability.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Retaliation Cadre" id="3bae-cf7-b9e3-4f00" import="true" type="upgrade">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1d6e-2579-8e7f-1ed4" field="selections" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Bonded Heroes" id="400b-c724-6710-76b1" hidden="false">
              <description>Each time a **^^T&apos;au Empire Battlesuit^^** model from your army makes a ranged attack that targets a unit within 12&quot;, improve the Strength characteristic of that attack by 1. If that attack targets a unit within 9&quot;, improve the Armour Penetration characteristic of that attack by 1 as well.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Kroot Hunting Pack" id="452e-5b5b-cdbc-c94a" import="true" type="upgrade">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1d6e-2579-8e7f-1ed4" field="selections" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Hunter&apos;s Instincts" id="4129-703-44-c6c" hidden="false">
              <description>Each time a **^^Kroot^^** model from your army makes an attack, add 1 to the Hit roll if the target of that attack is below its Starting Strength, and add 1 to the Wound roll as well if the target of that attack is Below Half-strength.</description>
            </rule>
            <rule name="Skirmish Fighters" id="67b0-9549-34a5-63e5" hidden="false">
              <description>**^^Kroot^^** models from your army have a 6+ invulnerable save against melee attacks and a 5+ invulnerable save against ranged attacks.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Auxiliary Cadre" id="97bc-1349-fb9d-c04f" hidden="false" import="true" type="upgrade">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1d6e-2579-8e7f-1ed4" field="selections" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Integrated Command Structure" id="eb32-1926-a607-c01c" hidden="false">
              <description>**^^Kroot^^** and **^^Vespid Stingwings^^** units from your army have the following ability:

**Targeting Triangulation (Aura):** While an enemy unit is within 9&quot; of and visible to this unit, each time a ranged attack made by a friendly **^^T’au Empire^^** model (excluding **^^Kroot^^**, **^^Vespid Stingwings^^** and TITANIC models) targets that enemy unit, improve the Armour Penetration characteristic of that attack by 1.

**^^T’au Empire^^** units (excluding **^^Kroot^^** and **^^Vespid Stingwings^^** units) from your army have the following ability:

**Localised Stealth Projectors (Aura):** While a friendly **^^Kroot^^** or **^^Vespid Stingwings^^** unit is wholly within 6&quot; of and visible to this unit, that **^^Kroot^^** or **^^Vespid Stingwings^^** unit can only be selected as the target of a ranged attack if the attacking model is within 18&quot;.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Experimental Prototype Cadre" id="1520-c344-f4fe-b414" import="true" type="upgrade">
          <modifierGroups>
            <modifierGroup type="and">
              <modifiers>
                <modifier affects="self.entries.forces.recursive.profiles.Ranged Weapons" field="annotation" join=", " scope="force" type="append" value="Superior Craftmanship">
                  <conditions>
                    <condition childId="1520-c344-f4fe-b414" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="greaterThan" value="0"/>
                  </conditions>
                </modifier>
                <modifier affects="self.entries.forces.recursive.profiles.Ranged Weapons" field="9896-9419-16a1-92fc" scope="force" type="increment" value="6">
                  <conditions>
                    <condition childId="1520-c344-f4fe-b414" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
            </modifierGroup>
          </modifierGroups>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1d6e-2579-8e7f-1ed4" field="selections" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Superior Craftmanship" id="492b-52cc-f6f2-0d20" hidden="false">
              <description>Add 6&quot; to the Range characteristic of ranged weapons equipped by **^^T&apos;au Empire^^** models from your army.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Kroot Raiding Party" id="deca-477c-ac30-a5ce" hidden="false" import="true" type="upgrade">
          <comment>Boarding Actions</comment>
          <infoLinks>
            <infoLink name="Void Combat Discipline" id="53b8-7555-5cdd-128b" hidden="false" targetId="1a7a-a079-15fb-f3d9" type="rule"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1d6e-2579-8e7f-1ed4" field="selections" includeChildSelections="true" scope="force" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Guerrilla Ambushers" id="c3df-ad7c-8ae8-a589" hidden="false">
              <description>Each time an enemy unit is selected to fire Overwatch, roll one D6: on a 4+, until the end of the turn, that unit cannot make Overwatch attacks that target **^^Kroot^^** units from your army.</description>
            </rule>
            <rule name="Forming Boarding Squads" id="c41b-d401-f3c3-5e52" hidden="false">
              <description>In the Form Boarding Squads step, a **^^Kroot Farstalkers^^** unit is split into two Boarding Squads, each containing 6 models.</description>
            </rule>
            <rule name="Mustering A Boarding Patrol" id="28a8-2a95-66d4-7e00" hidden="false">
              <description>You can include up to two of the following units (duplicates are not allowed):
- **^^Kroot Flesh Shaper^^**
- **^^Kroot Trail Shaper^^**
- **^^Kroot War Shaper^^**

You can include up to three of the following unit:
- **^^Kroot Carnivores^^** (10 models)

For each **^^Kroot Carnivores^^** unit you include, you can include up to one of each of the following units:
- **^^Kroot Farstalkers^^** (12 models)
- **^^Kroot Hounds^^** (5 models)
- **^^Krootox Riders^^** (1 model)</description>
            </rule>
            <rule name="Rules Adaptions" id="2154-b6a4-d144-ca67" hidden="false">
              <description>- **^^Kroot Carnivores^^** units can perform the Secure Site Tactical Manoeuvre as if they had the **^^Battleline^^** keyword.
- Each time you set up a **^^Kroot Carnivores^^** unit in an Entry Zone, you can set up a **^^Kroot Hounds^^** unit and/or a **^^Krootox Riders^^** unit in that same Entry Zone.
- If a **^^Kroot Carnivores^^** or **^^Kroot Farstalkers^^** unit from your army destroys an enemy unit while receiving the benefits of the **^^Kroot Flesh Shaper^^**&apos;s Rites of Feasting ability, the Feel No Pain 5+ ability they gain stays in effect, even after they stop receiving the benefit of that ability.
- The **^^Kroot Carnivores^^** unit loses the Fieldcraft ability.
- The **^^Kroot Hounds^^** unit loses the Loping Pounce ability.
- The **^^Krootox Riders^^** unit loses the Kroot Packmates ability.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Starfire Cadre" id="7e3b-b9cf-5be0-8bc1" hidden="false" import="true" type="upgrade">
          <comment>Boarding Actions</comment>
          <infoLinks>
            <infoLink name="Void Combat Discipline" id="7ec3-235a-20e8-5dd5" hidden="false" targetId="1a7a-a079-15fb-f3d9" type="rule"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1d6e-2579-8e7f-1ed4" field="selections" includeChildSelections="true" scope="force" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Rules Adaptions" id="45e2-9210-488d-e045" hidden="false">
              <description>- Rules that refer to Observer, Guided and/or Spotted units have no effect.
- **^^Crisis Battlesuits^^** units lose the Deep Strike ability.
- The **^^Kroot Carnivores^^** unit loses the Fieldcraft ability.
- The **^^Stealth Battlesuits^^** unit loses the Homing Beacon ability.
- The **^^Vespid Stingwings^^** unit loses the Deep Strike and Airborne Agility abilities.</description>
            </rule>
            <rule name="Mustering A Boarding Patrol" id="c2ad-57c3-924b-db66" hidden="false">
              <description>You can include up to two of the following units (duplicates are not allowed):
- **^^Cadre Fireblade^^**
- **^^Darkstrider^^**
- **^^Ethereal^^**

You can include up to three of each of the following units:
- **^^Breacher Team^^** (10 models)
- **^^Pathfinder Team^^** (5 or 10 models)
- **^^Strike Team^^** (10 models)

You can include up to one of each of the following units:
- **^^Kroot Carnivores^^** (10 models)
- **^^Stealth Battlesuits^^** (3 models)
- **^^Vespid Stingwings^^** (5 models)

You can include up to one of the following units:
- **^^Crisis Fireknife Battlesuits^^** (3 models)
- **^^Crisis Starscythe Battlesuits^^** (3 models)
- **^^Crisis Sunforge Battlesuits^^** (3 models)</description>
            </rule>
            <rule name="Forming Boarding Squads" id="dbdd-ec47-e3a2-45f0" hidden="false">
              <description>**^^Fire Warrior^^** units that do not contain a Fire Warrior Shas&apos;ui or Breacher Fire Warrior Shas&apos;ui model after you have Boarding Squads lose the **^^Markerlight^^** keyword.</description>
            </rule>
            <rule name="Markerlight Precision" id="c53e-77f2-6562-9205" hidden="false">
              <description>Each time a **^^T&apos;au Empire^^** unit from your army (excluding **^^Kroot^^** units) is selected to shoot, ranged weapons equipped by models in your unit have their Ballistic Skill characteristic improved by 1 and have the **[SUSTAINED HITS 1]** ability while targeting an enemy unit that is visible to one or more friendly **^^Markerlight^^** units that are not within Engagement Range of one or more enemy models.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Codex Battle Traits" id="3743-d313-0fa1-54f4" collapsible="true" hidden="false">
      <comment>Crusade content</comment>
      <selectionEntries>
        <selectionEntry name="Electrochaff Backups" id="fe59-bb81-fb62-a664" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e1ec-b60a-a8f1-dab8" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="1"/>
            <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="1"/>
            <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0"/>
            <cost name="Diplomatic Power" typeId="4d7c-04b6-8a79-837f" value="0"/>
            <cost name="Military Power" typeId="1cbe-d9c9-86a8-2d41" value="0"/>
          </costs>
          <modifiers>
