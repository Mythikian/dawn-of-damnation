                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">^^**Grey Knights^^** model only. Each time the bearer&apos;s unit is set up using the Deep Strike ability, until the end of the turn, enemy units cannot use the Fire Overwatch ability to shoot at the bearer&apos;s unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
