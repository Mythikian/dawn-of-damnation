                <profile name="Cuirass of Sacrifice" id="dc9c-12f3-bf6d-6f1f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The first time the bearer is destroyed, remove it from play without resolving its Deadly Demise ability (if it has this ability). Then, at the end of the phase, roll one D6: on a 2+, set the bearer back up on the battlefield as close as possible to where it was destroyed and not within Engagement Range of one or more enemy units, with 3 wounds remaining.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
