            <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0"/>
            <cost name="Purgation Points" typeId="d579-52c1-3e77-dd11" value="0"/>
          </costs>
          <profiles>
            <profile name="Eye of Judgement (Psychic)" id="43b3-b8cd-a5b9-f282" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time this model makes an attack, you can re-roll the Wound roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Blessing of the Omnissiah" id="8f25-c0fc-0a16-19a4" hidden="false" import="true" type="upgrade">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="cf47-a0d7-7207-29dc" field="selections" scope="root-entry" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Blessing of the Omnissiah" id="2f50-0a3e-92db-13bb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Infantry^^** only. In your Command phase, you can select one friendly **^^Grey Knights Vehicle^^** model within 3&quot; of this model. That model regains up to D3 lost wounds and, until the start of your next Command phase, each time that model makes an attack, add 1 to the Hit roll. Each model can only be selected for this ability once per turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Zealous Path" id="3ff0-5b1b-69c7-0f50" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Zealous Path" id="faf1-4d6b-e759-2dc1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, you can re-roll Charge rolls made for that unit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Clarion of Haste (Psychic)" id="d31e-a7bf-b95e-f929" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Clarion of Haste (Psychic)" id="e5c9-f84a-f724-1802" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, that unit is eligible to declare a charge in a turn in which it Advanced.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Haloed in Soulfire (Psychic)" id="f1f4-25ea-10be-f050" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Haloed in Soulfire (Psychic)" id="f568-409f-659c-04b6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, that unit can only be selected as the target of a ranged attack if the attack model is within 18&quot;.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Hammerhand (Psychic)" id="cb4d-81aa-04fe-cfe6" hidden="false" import="true" type="upgrade">
          <infoLinks>
            <infoLink name="Lethal Hits" id="0891-665f-daac-c5a7" hidden="false" targetId="d1d1-611e-5191-1095" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Hammerhand (Psychic)" id="a47d-0470-6504-2738" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, melee weapons equipped by models in that unit have the **[LETHAL HITS]** ability.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Litanies of Sanctity" id="5d2f-fb7f-fa81-89a1" hidden="false" import="true" type="upgrade">
          <infoLinks>
            <infoLink name="Litanies of Sanctity" id="f576-3963-b477-3df0" hidden="false" targetId="8d73-2ecd-2b3c-3f18" type="profile"/>
          </infoLinks>
        </selectionEntry>
        <selectionEntry name="Sanctic Hood" id="3102-df9c-1ffd-9fc3" hidden="false" import="true" type="upgrade">
          <infoLinks>
            <infoLink name="Feel No Pain" id="103d-ff8a-b80d-e848" hidden="false" targetId="9bf4-280f-bbe2-6fbb" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Sanctic Hood" id="208f-d793-f82d-67e5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Models in this unit have the Feel No Pain 4+ against Psychic Attacks.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Warrior Strategist" id="45d5-f2bd-6d33-f0a0" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Warrior Strategist" id="fd99-c92b-3649-0ac7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle round, one model from your army with this ability can use it when its unit is targeted with a Stratagem. If it does, reduce the CP cost of that use of that Stratagem by 1CP.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
