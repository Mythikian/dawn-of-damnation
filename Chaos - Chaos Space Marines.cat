          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is attached to a unit, once per turn, when this unit makes a Dark Pact, select one enemy unit within 12” and visible to this model. That unit must take a Battle-shock test or take D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
