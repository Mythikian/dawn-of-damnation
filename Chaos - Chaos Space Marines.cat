        </profile>
        <profile name="Reorder Reality" id="197b-d89e-1c1-403e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time an enemy unit within 18&quot; of this model targets this model, subtract 1 from the Hit roll and, until the end of the phase, that enemy unit’s ranged weapons have the [HAZARDOUS] ability.</characteristic>
          </characteristics>
        </profile>
