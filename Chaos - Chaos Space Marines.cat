    <selectionEntry name="Haarken Worldclaimer" id="d93f-6d73-1792-cb18" collective="false" hidden="false" import="true" type="model">
      <categoryLinks>
        <categoryLink name="Faction: Heretic Astartes" id="4243-719e-b035-1a61" hidden="false" primary="false" targetId="1e42-dfae-cbdd-207d"/>
        <categoryLink name="Infantry" id="2d91-1ea7-f6d-9eb5" hidden="false" primary="false" targetId="cf47-a0d7-7207-29dc"/>
