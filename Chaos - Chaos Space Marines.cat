            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
          </characteristics>
        </profile>
        <profile name="Fear Given Form" id="3518-8179-414d-f229" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Fight phase, select one enemy unit within Engagement Range of this model. That unit must take a Leadership test. If that test is failed, until the end of the phase, that unit cannot use Stratagems, and each time this model makes a melee attack against that unit, improve the Armour Penetration characteristic of that attack by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lone Agent" id="47f2-61c9-0f4f-e317" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model cannot be selected to be your Warlord.</characteristic>
          </characteristics>
        </profile>
      </profiles>
