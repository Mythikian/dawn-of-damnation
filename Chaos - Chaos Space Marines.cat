        <selectionEntry name="Falsehood" id="361e-2839-f32e-1873" hidden="false" import="true" sortIndex="18" type="upgrade">
          <comment>Deceptors</comment>
          <constraints>
            <constraint id="e58b-18c-f72-5932" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
