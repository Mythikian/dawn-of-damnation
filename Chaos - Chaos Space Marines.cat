        <profile name="A Cruel Angel&apos;s Joke" id="964d-ec53-9806-3a89" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The first time this model is destroyed. roll one D6 at the end of the phase: on a 4+, this model is no longer destroyed and in the Reinforcements step of your next Movement phase, it is set up anywhere on the battlefield using its Deep Strike ability with its full wounds remaining.</characteristic>
          </characteristics>
        </profile>
        <profile name="Heretic Speaker" id="7a38-7315-35d7-4fba" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, that unit gains the Dark Pacts ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Harbinger Of Ruin (Psychic)" id="84a3-c763-7e00-1cab" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While an enemy unit is within 9&quot; of this model, each time a model in that unit makes an attack. subtract 1 from the Hit roll, and. if that enemy unit is Below Half-strength, subtract 1 from the Wound roll as well.</characteristic>
          </characteristics>
        </profile>
      </profiles>
