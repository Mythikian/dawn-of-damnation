        </profile>
        <profile name="Primarch of the Iron Warriors" id="91bf-1900-760d-c397" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this model is in your army, it must be your Warlord.</characteristic>
          </characteristics>
        </profile>
        <profile name="Warp-Forged Bulwark (Psychic)" id="3899-08c0-556b-11b4" hidden="false" typeId="69b3-8c35-1614-9925" typeName="Lord of Iron">
          <characteristics>
            <characteristic name="Ability" typeId="202a-4f94-2fd2-1435">Friendly Non-MONSTER and Non-VEHICLE HERETIC ASTARTES units within 6&quot; of this model have a 5+ Invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Predictive Barrage (Psychic)" id="5dcc-2380-ff85-e29f" hidden="false" typeId="69b3-8c35-1614-9925" typeName="Lord of Iron">
          <characteristics>
            <characteristic name="Ability" typeId="202a-4f94-2fd2-1435">Select one enemy unit within 24&quot;. Until the end of the turn, friendly HERETIC ASTARTES units re-roll Hit rolls of 1 against that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Geometric Shielding (Psychic)" id="bce1-1f10-dab6-7ffd" hidden="false" typeId="69b3-8c35-1614-9925" typeName="Lord of Iron">
          <characteristics>
            <characteristic name="Ability" typeId="202a-4f94-2fd2-1435">Each time an attack is made against this model, subtract 1 from the Damage characteristic of that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Invulnerable Save" id="147b-355d-62ad-01fa" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged: 1-6 wounds remaining" id="40ba-c972-17cb-3b3d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model has 1-6 wounds remaining, each time this model makes an attack, subtract 1 from the Hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Iron Father of the Legion (Aura)" id="6c41-d84b-f4bd-e6d9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
