            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
          </characteristics>
        </profile>
        <profile name="Necrodermis Arm" id="8e28-4ede-02cf-6a66" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of each player&apos;s Command phase, this model regains up to 1 lost wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Bitter Vengeance" id="cbdb-b221-0d2b-9c27" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit,during the fights phase, each time an enemy unit has fought this unit and caused it to lose one or more wounds, roll a D6. On a 2-4 that enemy unit takes D3 mortal wounds; on a 5+ that enemy unit takes 3 mortal wounds. A unit can only be the target of this ability once per phase</characteristic>
          </characteristics>
        </profile>
        <profile name="Half-Breed" id="0036-a195-4ba1-3951" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, in the shooting phase, each time a model in this unit makes a ranged attack, if this unit Remained Stationary, add 1 to the Wound roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Honsou&apos;s bolt pistol" id="1a1c-66be-2075-d4f6" collective="false" hidden="false" import="true" type="upgrade">
