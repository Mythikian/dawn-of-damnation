        <profile name="Warpsmith" id="9451-72d-3d9e-1287" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3&quot; of one or more friendly ^^**Heretic Astartes Vehicle**^^ units, this model has the Lone Operative ability.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="9b8f-694b-e5e-b573" type="set" value="While this model is within 6&quot; of one or more friendly ^^**Heretic Astartes Vehicle**^^ units, this model has the Lone Operative ability.">
              <conditions>
                <condition childId="2c8c-811f-f25f-40ab" field="selections" includeChildSelections="true" scope="440-a22a-eac1-b107" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Master of Mechanisms" id="5cf1-da0b-da34-3342" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Command phase, select one friendly ^^**Heretic Astartes Vehicle**^^ model within 3&quot; of this model. That **^^ Vehicle**^^ model regains up to D3 lost wounds and, until the start of your next Command phase, each time that **^^Vehicle**^^ makes an attack, add 1 to the Hit roll. Each model can only be selected for this ability once per Command phase.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="9b8f-694b-e5e-b573" type="set" value="In your Command phase, select one friendly ^^**Heretic Astartes Vehicle**^^ model within 6&quot; of this model. That **^^ Vehicle**^^ model regains up to D3 lost wounds and, until the start of your next Command phase, each time that **^^Vehicle**^^ makes an attack, add 1 to the Hit roll. Each model can only be selected for this ability once per Command phase.">
              <conditions>
                <condition childId="2c8c-811f-f25f-40ab" field="selections" includeChildSelections="true" scope="440-a22a-eac1-b107" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Enrage Machine Spirits" id="bc89-81a3-34db-b283" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of your Movement phase, select one enemy ^^**Vehicle**^^ unit within 12&quot; of this model. That unit must take a Battle-shock test.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="9b8f-694b-e5e-b573" type="set" value="At the end of your Movement phase, select one enemy ^^**Vehicle**^^ unit within 15&quot; of this model. That unit must take a Battle-shock test.">
              <conditions>
                <condition childId="2c8c-811f-f25f-40ab" field="selections" includeChildSelections="true" scope="440-a22a-eac1-b107" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Leader" id="b5da-4ab-cfb5-4e4c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units: ^^**Chosen, Havocs, Legionaires**^^</characteristic>
          </characteristics>
        </profile>
