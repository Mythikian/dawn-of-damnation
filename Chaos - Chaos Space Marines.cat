          </characteristics>
        </profile>
        <profile name="Renegade Ogryn Brutes" id="dd65-f1a0-8b3f-9827" hidden="false" typeId="74f8-5443-9d6d-1f1e" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="30f2-be70-861d-1b84">For the purposes of embarking within TRANSPORTS, each Renegade Ogryn Brute model counts as one TERMINATOR model.</characteristic>
