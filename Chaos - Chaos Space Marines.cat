          <profiles>
            <profile name="Dark Zealotry" id="0558-6bd5-ce39-ca09" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a model in this unit makes a melee attack, add 1 to the Wound roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Lord of Chaos" id="a5de-ce59-0b3f-ea7a" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Lord of Chaos" id="d9d7-b9f8-e139-b611" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle round, one unit from your army with this ability can be targeted with a Stratagem for 0CP, even if a different unit from your army has been targeted with that Stratagem this phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Master of Mechanisms" id="dde6-7bd4-d034-f25d" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Master of Mechanisms" id="b06c-8cf7-5125-6f4c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Command phase, select one friendly ^^**Heretic Astartes Vehicle**^^ model within 3&quot; of this model. That ^^**Vehicle**^^ model regains up to D3 lost wounds and, until the start of your next Command phase, each time that ^^**Vehicle**^^ makes an attack, add 1 to the Hit roll. Each model can only be selected for this ability once per Command phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Prescience (Psychic)" id="e0f2-bfa2-9e39-9e60" hidden="false" import="true" type="upgrade">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="13bf-2bee-3ae0-b414" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Prescience (Psychic)" id="e50d-80b5-c26f-7923" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time an attack targets this unit, subtract 1 from the Hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
