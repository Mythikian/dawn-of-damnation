          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units:
■ CHOSEN
■ HAVOCS
■ LEGIONARIES</characteristic>
          </characteristics>
        </profile>
        <profile name="Armanneus Valthex" id="9b5d-871f-bbc5-c3ea" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6&quot;</characteristic>
