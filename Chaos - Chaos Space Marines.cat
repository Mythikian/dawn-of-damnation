            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
          </characteristics>
        </profile>
        <profile name="Traitor Techmarine" id="8f5a-911d-3ebf-a672" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3&quot; of one or more friendly HERETIC ASTARTES VEHICLE units, this model has the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Indynabula Array" id="8104-85e1-7566-4d23" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Command phase, select one friendly HERETIC ASTARTES VEHICLE model within 3&quot; of this model. That VEHICLE model regains up to D3 lost wounds and, until the start of your next Command phase, each time that VEHICLE makes an attack, it gains [DEVASTATING WOUNDS]. A unit targeted by this ability cannot benefit from the Master of Mechanisms ability this turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of the Forge Reborn" id="89c3-d3de-b85e-b066" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle, when this model and any unit it is attached to is selected to shoot or fight, you may activate the Indynabula Array’s overload: Until the end of the phase when this model and any unit it is attached to make an attack, add 1 to the hit roll and add 1 to the wound roll against VEHICLE or MONSTER units.</characteristic>
          </characteristics>
        </profile>
      </profiles>
