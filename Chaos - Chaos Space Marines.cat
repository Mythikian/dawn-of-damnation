          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3&quot; of one or more friendly ^^**Daemon Vehicle^^** units, this model has the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
