          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If a unit from your army with the Leader ability can be attached to a LEGIONAIRES, it can be attached to this unit instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="Everywhere And Nowhere" id="a16a-fe4a-1fbc-34f1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle, when an enemy unit ends a Normal, Advance or Fall Back move within 9&quot; of the bearers unit if this unit is not within Engagement Range of one or more enemy units, you can remove this unit from the battlefield and place it into Strategic Reserves.</characteristic>
          </characteristics>
        </profile>
        <profile name="Saboteurs" id="b155-a16a-e5bb-6d72" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle round, you can target one model with this ability with the Rapid Ingress Stratagem for OCP.</characteristic>
          </characteristics>
        </profile>
      </profiles>
