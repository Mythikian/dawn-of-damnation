          </modifiers>
          <profiles>
            <profile name="Thaa&apos;ris and Rhi&apos;ol, the Rapacious" id="ca52-d57a-856b-317b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The bearer gains the **^^Slaanesh^^** keyword. In the Fight phase, if the bearer&apos;s unit makes a Dark Pact, until the end of the phase, add 3 to the Attacks characteristic of melee weapons equipped by the bearer and those weapons gain the **[LANCE]** ability.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Zaall, the Wrathful" id="967a-2476-807e-3a22" hidden="false" import="true" type="upgrade">
