          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this unit contains a Traitor Ogryn model, CHARACTER models in this unit have the Feel No Pain 4+ ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
