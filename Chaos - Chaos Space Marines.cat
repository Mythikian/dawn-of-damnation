    <selectionEntry name="Masters of the Maelstrom" id="a998-9dce-fbab-8d32" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Epic Hero" id="5cfa-7e3b-8800-25cc" hidden="false" primary="true" targetId="4f3a-f0f7-6647-348d"/>
